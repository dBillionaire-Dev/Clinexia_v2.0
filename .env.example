SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

ADMIN_PASSWORD=your-admin-password
ADMIN_SESSION_SECRET=your-long-random-secret

# ConvertLAB mobile app / repository destination used by the /home landing page.
# Replace this with the Play Store URL when the Android app is published.
NEXT_PUBLIC_CONVERTLAB_MOBILE_URL=https://github.com/dBillionaire-Dev/ConvertLAB_V3.0-Mobile
NEXT_PUBLIC_APK_URL=direct link to Clinexia-3.0.0.apk
NEXT_PUBLIC_APK_SHA256=your_long_string_secret_here
NEXT_PUBLIC_APK_VERSION=version_number
# Landing page (/welcome): Android download button. Leave empty until the app is published.
NEXT_PUBLIC_PLAY_STORE_URL=
NEXT_PUBLIC_APK_URL=

# Two domains: landing page on one, the app on another. Leave empty for a single domain.
# NEXT_PUBLIC_SITE_URL should be the APP address when you split.
NEXT_PUBLIC_LANDING_URL=
NEXT_PUBLIC_APP_URL=

# Retire the old address (opt-in). Both must be set for the redirect to happen.
NEXT_PUBLIC_LEGACY_HOSTS=
NEXT_PUBLIC_LEGACY_REDIRECT=

# Clinexia deployment and official download destinations
NEXT_PUBLIC_SITE_URL=https://public-site.com
NEXT_PUBLIC_CLINEXIA_APK_URL=
NEXT_PUBLIC_CLINEXIA_FIREBASE_URL=
NEXT_PUBLIC_CLINEXIA_PALMSTORE_URL=
NEXT_PUBLIC_CLINEXIA_GOOGLE_PLAY_URL=
NEXT_PUBLIC_CLINEXIA_MICROSOFT_STORE_URL=

# Download channels on the landing page (leave empty until they exist)
NEXT_PUBLIC_PLAY_STORE_URL=
NEXT_PUBLIC_FIREBASE_DIST_URL=
NEXT_PUBLIC_APK_URL=
NEXT_PUBLIC_APK_SHA256=
NEXT_PUBLIC_APK_VERSION=
NEXT_PUBLIC_MS_STORE_URL=
# Age-rating id for the Microsoft Store (from the IARC questionnaire in Partner Center)
NEXT_PUBLIC_IARC_RATING_ID=
SUPABASE_ANON_KEY

# ---- Integration: embed (Phase 1) -------------------------------------------------------------------------------
# Comma-separated origins allowed to frame /embed and to exchange postMessages with it, e.g.
# https://emr.hospital.org,https://lis.lab.org . Bare origins only (no path, no wildcard). Merged with the embed_partners
# table in Supabase. Empty = /embed can only be framed by this site itself.
EMBED_ALLOWED_ORIGINS=

# ---- Integration: public API v1 (Phase 4) -----------------------------------------------------------------------
# Calls per minute allowed per API key (per server instance). Whole number, 1 to 100000. Default 60.
API_RATE_LIMIT_PER_MINUTE=60

# ---- Integration: SMART on FHIR launcher (Phase 6) ---------------------------------------------------------------
# Client id registered with the EHR for this app. SMART apps are public clients (PKCE, no secret). /smart/launch refuses to start without it.
NEXT_PUBLIC_SMART_CLIENT_ID=
# Comma-separated FHIR server base URLs (the "iss") this app may connect to, https only. EMPTY = every launch is refused.
# For SMART App Launcher sandbox testing: https://launch.smarthealthit.org/v/r4/fhir
NEXT_PUBLIC_SMART_ALLOWED_ISS=
# Days after which a result read from the record is flagged as old. Creatinine 30 and height 365 are the agreed defaults; 90 for everything else is a placeholder.
NEXT_PUBLIC_SMART_STALE_DAYS_CREATININE=30
NEXT_PUBLIC_SMART_STALE_DAYS_HEIGHT=365
NEXT_PUBLIC_SMART_STALE_DAYS_OTHER=90

# ---- Integration: CDS Hooks service stub (Phase 6) ---------------------------------------------------------------
# OFF unless exactly "true". CDS Hooks base URL for this app is https://<host>/api (discovery: /api/cds-services).
CDS_HOOKS_ENABLED=false
# Optional stopgap until the EHR's signed JWT is verified: when set, calls must send "Authorization: Bearer <this value>".
CDS_HOOKS_SHARED_SECRET=
