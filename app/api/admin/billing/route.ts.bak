import { NextResponse } from "next/server"
import { isAdminAuthenticated } from "@/lib/admin-auth"
import { billingEnabled, SPECIALTIES } from "@/lib/billing/config"
import { addMonthsUtc } from "@/lib/billing/lifecycle"
import { cleanSpecialties } from "@/lib/billing/pricing"
import { getPricing, grantOrganisationSubscription, listAuditEvents, listOrganisationsForAdmin, recordAudit, savePricingConfig, setManagedStatus, setSuspended } from "@/lib/billing/store"
import { isUuid } from "@/lib/billing/db"
import { cleanTrialDays, resolveLaunch, trialEnd } from "@/lib/billing/launch"
import { getLaunch, saveLaunch } from "@/lib/billing/launch-store"

export const dynamic = "force-dynamic"

const out = (data: unknown, status = 200) => NextResponse.json(data, { status, headers: { "Cache-Control": "no-store" } })

// Platform administrator API (uses the existing admin login). Pricing, discount verification, suspension, manual grants, audit trail.
export async function GET() {
  if (!billingEnabled()) return new NextResponse(null, { status: 404 })
  if (!(await isAdminAuthenticated())) return new NextResponse("Unauthorized", { status: 401 })
  const [pricing, organisations, audit, launch] = await Promise.all([getPricing(), listOrganisationsForAdmin(), listAuditEvents(undefined, 100), getLaunch()])
  return out({ pricing, organisations, audit, launch: resolveLaunch(launch, process.env, Date.now()) })
}

export async function POST(request: Request) {
  if (!billingEnabled()) return new NextResponse(null, { status: 404 })
  if (!(await isAdminAuthenticated())) return new NextResponse("Unauthorized", { status: 401 })
  const origin = request.headers.get("origin")
  if (origin && origin !== new URL(request.url).origin) return out({ error: "Cross-origin admin request rejected." }, 403)

  let body: any
  try {
    body = await request.json()
  } catch {
    return out({ error: "Invalid request." }, 400)
  }
  const orgId = typeof body?.orgId === "string" ? body.orgId : ""
  const needOrg = () => (isUuid(orgId) ? null : out({ error: "Invalid organisation." }, 400))

  switch (body?.action) {
    case "setPricing": {
      const saved = await savePricingConfig(body.config)
      await recordAudit({ actorKind: "platform_admin", action: "pricing.updated", detail: { managedDiscountBps: saved.managedDiscountBps } })
      return out({ pricing: saved })
    }
    case "setLaunch": {
      // The "Switch on billing" button. enforce=false switches locking off; trialDays > 0 gives everyone full access for that long first.
      const trialDays = cleanTrialDays(body.trialDays)
      if (typeof body.enforce !== "boolean" || trialDays === null) return out({ error: "Choose on or off, and 0 to 365 free days." }, 400)
      const now = Date.now()
      const state = { enforce: body.enforce, freeUntil: body.enforce ? trialEnd(now, trialDays) : null }
      await saveLaunch(state)
      await recordAudit({ actorKind: "platform_admin", action: state.enforce ? "billing.switched_on" : "billing.switched_off", detail: { trialDays: state.enforce ? trialDays : 0, freeUntil: state.freeUntil } })
      return out({ launch: resolveLaunch(state, process.env, now) })
    }
    case "verifyManaged":
    case "rejectManaged": {
      const bad = needOrg()
      if (bad) return bad
      const status = body.action === "verifyManaged" ? "verified" : "rejected"
      if (!(await setManagedStatus(orgId, status))) return out({ error: "Organisation not found." }, 404)
      await recordAudit({ orgId, actorKind: "platform_admin", action: `managed.${status}` })
      return out({ ok: true })
    }
    case "suspend":
    case "restore": {
      const bad = needOrg()
      if (bad) return bad
      if (!(await setSuspended(orgId, body.action === "suspend"))) return out({ error: "Organisation not found." }, 404)
      await recordAudit({ orgId, actorKind: "platform_admin", action: body.action === "suspend" ? "org.suspended" : "org.restored" })
      return out({ ok: true })
    }
    case "grant": {
      // Invoiced or negotiated contract: activate without an online payment.
      const bad = needOrg()
      if (bad) return bad
      const plan = body.plan === "all_access" ? "all_access" : body.plan === "specialty" ? "specialty" : null
      const seats = Number(body.seats)
      const months = Number(body.months)
      const specialties = plan === "specialty" ? cleanSpecialties(body.specialties) : []
      if (!plan || !specialties || (plan === "specialty" && specialties.length === 0)) return out({ error: "Choose a plan and specialties." }, 400)
      if (!Number.isInteger(seats) || seats < 1 || seats > 5000 || !Number.isInteger(months) || months < 1 || months > 24) return out({ error: "Seats or months out of range." }, 400)
      await grantOrganisationSubscription(orgId, { plan, specialties, seats }, new Date(addMonthsUtc(Date.now(), months)).toISOString())
      await recordAudit({ orgId, actorKind: "platform_admin", action: "subscription.granted", detail: { plan, seats, months, specialties: plan === "specialty" ? specialties : [...SPECIALTIES] } })
      return out({ ok: true })
    }
    default:
      return out({ error: "Unknown action." }, 400)
  }
}
