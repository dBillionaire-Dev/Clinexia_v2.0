// Supabase-backed implementation of OrgStore and PaymentStore, plus the lookups the routes need.
import { db, eq, isUuid, uuid, type Row } from "./db"
import { DEFAULT_PRICING, SPECIALTIES, parsePricingConfig, type Currency, type Market, type PricingConfig, type Specialty } from "./config"
import { deleteAuthUser, getAuthUser, listAuthUsers } from "./admin-users"
import { canDeleteUser } from "./admin-rules"
import { addMonthsUtc } from "./lifecycle"
import type { MembershipContext, PlanRecord } from "./entitlements"
import type { AcceptResult, CreateInviteResult, InviteRecord, MemberRecord, OrgRecord, OrgStore } from "./org-actions"
import type { ApplyResult, PaymentStore } from "./payments"
import type { OrgRole } from "./roles"

const specs = (v: unknown): Specialty[] => (Array.isArray(v) ? v.filter((s): s is Specialty => (SPECIALTIES as readonly string[]).includes(s)) : [])

const toPlan = (r: Row | undefined | null): PlanRecord | null =>
  r ? { plan: r.plan, specialties: specs(r.specialties), status: r.status, currentPeriodEnd: r.current_period_end ?? null } : null

export async function getPricing(): Promise<PricingConfig> {
  try {
    const [row] = await db.select("billing_settings", "select=config&id=eq.1")
    return row ? parsePricingConfig(row.config) : DEFAULT_PRICING
  } catch {
    return DEFAULT_PRICING
  }
}

export async function savePricingConfig(config: unknown): Promise<PricingConfig> {
  const clean = parsePricingConfig(config)
  const stamp = new Date().toISOString()
  const changed = await db.update("billing_settings", "id=eq.1", { config: clean, updated_at: stamp })
  if (changed.length === 0) await db.insert("billing_settings", { id: 1, config: clean, updated_at: stamp })
  return clean
}

export async function getSubscriptionFor(owner: { userId?: string; orgId?: string }): Promise<(PlanRecord & { id: string; seats: number; cancelAtPeriodEnd: boolean }) | null> {
  const filter = owner.orgId ? `org_id=eq.${uuid(owner.orgId)}` : `user_id=eq.${uuid(owner.userId)}`
  const [r] = await db.select("billing_subscriptions", `select=*&${filter}`)
  return r ? { ...(toPlan(r) as PlanRecord), id: r.id, seats: r.seats, cancelAtPeriodEnd: r.cancel_at_period_end === true } : null
}

/** Everything resolveEntitlements needs for one signed-in user. */
export async function loadEntitlementInputs(userId: string): Promise<{ individual: PlanRecord | null; memberships: MembershipContext[] }> {
  const uid = uuid(userId)
  const [own, mems] = await Promise.all([db.select("billing_subscriptions", `select=*&user_id=eq.${uid}`), db.select("billing_memberships", `select=*&user_id=eq.${uid}`)])
  const memberships: MembershipContext[] = []
  for (const m of mems) {
    const orgId = uuid(m.org_id)
    const [[org], [sub], order] = await Promise.all([
      db.select("billing_organisations", `select=*&id=eq.${orgId}`),
      db.select("billing_subscriptions", `select=*&org_id=eq.${orgId}`),
      db.select("billing_memberships", `select=user_id&org_id=eq.${orgId}&order=joined_at.asc,id.asc`),
    ])
    if (!org) continue
    memberships.push({
      orgId,
      role: m.role as OrgRole,
      allSpecialties: m.all_specialties === true,
      specialties: specs(m.specialties),
      seatIndex: Math.max(0, order.findIndex((o) => o.user_id === uid)),
      orgSeats: org.seats,
      orgSuspended: org.suspended === true,
      orgPlan: toPlan(sub),
    })
  }
  return { individual: toPlan(own[0]), memberships }
}

export async function listUserOrganisations(userId: string) {
  const mems = await db.select("billing_memberships", `select=org_id,role&user_id=eq.${uuid(userId)}`)
  if (!mems.length) return []
  const ids = mems.map((m) => uuid(m.org_id)).join(",")
  const orgs = await db.select("billing_organisations", `select=id,name&id=in.(${ids})`)
  return mems.map((m) => ({ orgId: m.org_id as string, role: m.role as OrgRole, name: (orgs.find((o) => o.id === m.org_id)?.name ?? "") as string }))
}

const toMember = (m: Row, profile?: Row, email?: string): MemberRecord => ({
  userId: m.user_id, email: email ?? "", fullName: profile?.full_name ?? "", role: m.role, allSpecialties: m.all_specialties === true, specialties: specs(m.specialties), joinedAt: m.joined_at,
})

async function emailsFor(userIds: string[]): Promise<Map<string, string>> {
  // Emails live in Supabase Auth. Read them one by one through the admin API (organisations are small; capped by seat count).
  const url = process.env.SUPABASE_URL
  const key = process.env.SUPABASE_SERVICE_ROLE_KEY
  const out = new Map<string, string>()
  if (!url || !key) return out
  await Promise.all(userIds.map(async (id) => {
    try {
      const res = await fetch(`${url.replace(/\/$/, "")}/auth/v1/admin/users/${uuid(id)}`, { headers: { apikey: key, Authorization: `Bearer ${key}` }, cache: "no-store" })
      if (res.ok) out.set(id, String(((await res.json()) as any).email ?? ""))
    } catch { /* leave blank */ }
  }))
  return out
}

export const orgStore: OrgStore = {
  async getOrg(orgId) {
    if (!isUuid(orgId)) return null
    const [[o], [sub]] = await Promise.all([db.select("billing_organisations", `select=*&id=eq.${orgId}`), db.select("billing_subscriptions", `select=*&org_id=eq.${orgId}`)])
    if (!o) return null
    return { id: o.id, name: o.name, orgType: o.org_type, market: o.market === "intl" ? "intl" : "ng", seats: o.seats, suspended: o.suspended === true, managedStatus: o.managed_status, plan: toPlan(sub) } satisfies OrgRecord
  },
  async getMember(orgId, userId) {
    if (!isUuid(orgId) || !isUuid(userId)) return null
    const [m] = await db.select("billing_memberships", `select=*&org_id=eq.${orgId}&user_id=eq.${userId}`)
    return m ? toMember(m) : null
  },
  async listMembers(orgId) {
    const rows = await db.select("billing_memberships", `select=*&org_id=eq.${uuid(orgId)}&order=joined_at.asc,id.asc`)
    const ids = rows.map((r) => r.user_id as string)
    const [profiles, emails] = await Promise.all([ids.length ? db.select("billing_profiles", `select=user_id,full_name&user_id=in.(${ids.map(uuid).join(",")})`) : [], emailsFor(ids)])
    return rows.map((r) => toMember(r, profiles.find((p) => p.user_id === r.user_id), emails.get(r.user_id)))
  },
  async listPendingInvites(orgId) {
    const rows = await db.select("billing_invitations", `select=*&org_id=eq.${uuid(orgId)}&status=eq.pending&expires_at=gt.${encodeURIComponent(new Date().toISOString())}&order=created_at.desc`)
    return rows.map((r): InviteRecord => ({ id: r.id, email: r.email, role: r.role, allSpecialties: r.all_specialties === true, specialties: specs(r.specialties), expiresAt: r.expires_at }))
  },
  async createOrg({ name, orgType, ownerUserId }) {
    const owner = uuid(ownerUserId)
    const org = await db.insert("billing_organisations", { name, org_type: orgType, owner_user_id: owner, market: await getUserMarket(owner) })
    try {
      await db.insert("billing_memberships", { org_id: org!.id, user_id: owner, role: "owner", all_specialties: true, specialties: [] })
    } catch (error) {
      await db.remove("billing_organisations", `id=eq.${org!.id}`).catch(() => undefined) // do not leave an owner-less organisation behind
      throw error
    }
    return { id: org!.id }
  },
  async createInvite(i): Promise<CreateInviteResult> {
    const r = await db.rpc<{ ok: boolean; reason?: string; id?: string }>("billing_create_invitation", {
      p_org: uuid(i.orgId), p_email: i.email, p_role: i.role, p_all: i.allSpecialties, p_specs: i.specialties, p_token_hash: i.tokenHash, p_expires: i.expiresAt, p_by: uuid(i.invitedBy),
    })
    if (!r.ok) return { ok: false, reason: (r.reason as "no_capacity" | "duplicate_invite" | "already_member") ?? "no_capacity" }
    return { ok: true, invite: { id: r.id!, email: i.email, role: i.role, allSpecialties: i.allSpecialties, specialties: i.specialties, expiresAt: i.expiresAt } }
  },
  async revokeInvite(orgId, inviteId) {
    if (!isUuid(inviteId)) return false
    return (await db.update("billing_invitations", `id=eq.${inviteId}&org_id=eq.${uuid(orgId)}&status=eq.pending`, { status: "revoked" })).length > 0
  },
  async removeMember(orgId, userId) {
    return (await db.remove("billing_memberships", `org_id=eq.${uuid(orgId)}&user_id=eq.${uuid(userId)}`)).length > 0
  },
  async updateMember(orgId, userId, patch) {
    return (await db.update("billing_memberships", `org_id=eq.${uuid(orgId)}&user_id=eq.${uuid(userId)}`, { all_specialties: patch.allSpecialties, specialties: patch.specialties })).length > 0
  },
  async acceptInvite({ tokenHash, userId, email }): Promise<AcceptResult> {
    const r = await db.rpc<{ ok: boolean; reason?: string; org_id?: string }>("billing_accept_invitation", { p_token_hash: tokenHash, p_user: uuid(userId), p_email: email })
    return r.ok ? { ok: true, orgId: r.org_id! } : { ok: false, reason: (r.reason as any) ?? "invalid" }
  },
  async audit(e) {
    await recordAudit({ orgId: e.orgId, actorUserId: e.actorUserId, action: e.action, detail: e.detail })
  },
}

export async function recordAudit(e: { orgId?: string | null; actorUserId?: string | null; actorKind?: "user" | "platform_admin" | "system"; action: string; detail?: Record<string, unknown> }) {
  try {
    await db.insert("billing_audit_events", { org_id: e.orgId ?? null, actor_user_id: e.actorUserId ?? null, actor_kind: e.actorKind ?? "user", action: e.action, detail: e.detail ?? {} })
  } catch (error) {
    console.error("Clinexia billing audit write failed:", error instanceof Error ? error.message : "unknown") // never block the action on the log
  }
}

export const paymentStore: PaymentStore = {
  async claimEvent(key, type) {
    return (await db.rpc<boolean>("billing_claim_webhook", { p_key: key, p_type: type })) === true
  },
  async releaseEvent(key) {
    await db.remove("billing_webhook_events", `event_key=eq.${encodeURIComponent(key)}`)
  },
  async applyPaidOrder(i): Promise<ApplyResult> {
    const r = await db.rpc<{ ok: boolean; reason?: string; already?: boolean; owner_kind?: "user" | "org"; owner_id?: string }>("billing_apply_paid_order", {
      p_reference: i.reference, p_amount: i.amountMinor, p_currency: i.currency, p_provider_id: i.providerId,
    })
    if (!r.ok) return { ok: false, reason: (r.reason as any) ?? "unknown_reference" }
    return { ok: true, already: r.already === true, ownerKind: r.owner_kind!, ownerId: r.owner_id! }
  },
  async audit(e) {
    await recordAudit({ actorKind: "system", action: e.action, detail: e.detail })
  },
}

export async function createOrder(input: {
  reference: string; currency: Currency; subscriptionId: string; userId?: string; orgId?: string; payerUserId: string; amountMinor: number; target: Row; quote: Row
}) {
  await db.insert("billing_orders", {
    reference: input.reference, subscription_id: uuid(input.subscriptionId), user_id: input.userId ? uuid(input.userId) : null, org_id: input.orgId ? uuid(input.orgId) : null,
    payer_user_id: uuid(input.payerUserId), amount_kobo: input.amountMinor, currency: input.currency, status: "pending", target: input.target, quote: input.quote, period_months: 1,
  })
}

export async function getOrder(reference: string): Promise<Row | null> {
  const [o] = await db.select("billing_orders", `select=*&reference=${eq(reference)}`)
  return o ?? null
}

/** Creates the (pending) subscription row for an owner if there is none yet. Existing rows are never changed here; payment does that. */
export async function ensureSubscription(owner: { userId?: string; orgId?: string }, target: { plan: string; specialties: string[]; seats: number }): Promise<string> {
  const existing = await getSubscriptionFor(owner)
  if (existing) return existing.id
  const row = await db.insert("billing_subscriptions", {
    user_id: owner.userId ? uuid(owner.userId) : null, org_id: owner.orgId ? uuid(owner.orgId) : null,
    plan: target.plan, specialties: target.specialties, seats: target.seats, status: "pending",
  })
  return row!.id
}

export async function cancelAtPeriodEnd(owner: { userId?: string; orgId?: string }): Promise<boolean> {
  const filter = owner.orgId ? `org_id=eq.${uuid(owner.orgId)}` : `user_id=eq.${uuid(owner.userId)}`
  return (await db.update("billing_subscriptions", `${filter}&status=in.(active,past_due)`, { status: "cancelled", cancel_at_period_end: true, updated_at: new Date().toISOString() })).length > 0
}

export async function seatCounts(orgId: string) {
  const id = uuid(orgId)
  const [members, pending] = await Promise.all([
    db.select("billing_memberships", `select=id&org_id=eq.${id}`),
    db.select("billing_invitations", `select=id&org_id=eq.${id}&status=eq.pending&expires_at=gt.${encodeURIComponent(new Date().toISOString())}`),
  ])
  return { members: members.length, pendingInvitations: pending.length }
}

// ---- platform administration helpers (called only from the admin route) ----
export async function listOrganisationsForAdmin() {
  const [orgs, subs] = await Promise.all([db.select("billing_organisations", "select=*&order=created_at.desc&limit=500"), db.select("billing_subscriptions", "select=*&org_id=not.is.null")])
  return orgs.map((o) => ({
    id: o.id as string, name: o.name as string, orgType: o.org_type as string, market: (o.market === "intl" ? "intl" : "ng") as Market, seats: o.seats as number, managedStatus: o.managed_status as string, suspended: o.suspended === true, createdAt: o.created_at as string,
    subscription: toPlan(subs.find((s) => s.org_id === o.id)),
  }))
}

export async function listAuditEvents(orgId?: string, limit = 100) {
  const filter = orgId ? `&org_id=eq.${uuid(orgId)}` : ""
  return db.select("billing_audit_events", `select=*&order=at.desc&limit=${Math.min(Math.max(1, limit), 500)}${filter}`)
}

export async function setManagedStatus(orgId: string, status: "requested" | "verified" | "rejected" | "none") {
  return (await db.update("billing_organisations", `id=eq.${uuid(orgId)}`, { managed_status: status })).length > 0
}

export async function setSuspended(orgId: string, suspended: boolean) {
  return (await db.update("billing_organisations", `id=eq.${uuid(orgId)}`, { suspended })).length > 0
}

/** For negotiated or invoiced contracts: activates an organisation's subscription without an online payment. */
export async function grantOrganisationSubscription(orgId: string, target: { plan: "specialty" | "all_access"; specialties: Specialty[]; seats: number }, periodEndIso: string) {
  const id = uuid(orgId)
  const subId = await ensureSubscription({ orgId: id }, target)
  await db.update("billing_subscriptions", `id=eq.${uuid(subId)}`, {
    plan: target.plan, specialties: target.specialties, seats: target.seats, status: "active", current_period_end: periodEndIso, cancel_at_period_end: false, updated_at: new Date().toISOString(),
  })
  await db.update("billing_organisations", `id=eq.${id}`, { seats: target.seats })
}

// ---- markets (which price list applies) ----
export async function getUserMarket(userId: string): Promise<Market | null> {
  const [p] = await db.select("billing_profiles", `select=market&user_id=eq.${uuid(userId)}`)
  return p ? (p.market === "intl" ? "intl" : "ng") : null
}

export async function setUserMarket(userId: string, market: Market) {
  return (await db.update("billing_profiles", `user_id=eq.${uuid(userId)}`, { market })).length > 0
}

export async function setOrgMarket(orgId: string, market: Market) {
  return (await db.update("billing_organisations", `id=eq.${uuid(orgId)}`, { market })).length > 0
}

// ---- user status (suspension) ----
export interface UserStatus { status: "active" | "suspended"; reason: string | null; notice: string | null }

export async function getUserStatus(userId: string): Promise<UserStatus> {
  const [r] = await db.select("billing_user_status", `select=status,reason,notice&user_id=eq.${uuid(userId)}`)
  return r ? { status: r.status === "suspended" ? "suspended" : "active", reason: r.reason ?? null, notice: r.notice ?? null } : { status: "active", reason: null, notice: null }
}

export async function setUserStatus(userId: string, status: "active" | "suspended", reason: string | null, notice: string | null) {
  const id = uuid(userId)
  const row = { status, reason, notice, suspended_at: status === "suspended" ? new Date().toISOString() : null, updated_at: new Date().toISOString() }
  const changed = await db.update("billing_user_status", `user_id=eq.${id}`, row)
  if (changed.length === 0) await db.insert("billing_user_status", { user_id: id, ...row })
}

// ---- administrator views ----
export interface AdminUserRow {
  id: string; email: string; fullName: string; accountType: string; source: string; market: Market; status: "active" | "suspended"
  createdAt: string | null; lastSignInAt: string | null; confirmed: boolean
  plan: { plan: string; specialties: Specialty[]; status: string; currentPeriodEnd: string | null } | null
  organisations: number
}

/** Everyone with a Clinexia account, joined with profile, status, plan and membership counts. `q` filters by email or name. */
export async function loadAdminUsers(q: string): Promise<{ users: AdminUserRow[]; truncated: boolean }> {
  const [{ users, truncated }, profiles, statuses, subs, mems] = await Promise.all([
    listAuthUsers(),
    db.select("billing_profiles", "select=user_id,full_name,account_type,market,source&limit=5000"),
    db.select("billing_user_status", "select=user_id,status&limit=5000"),
    db.select("billing_subscriptions", "select=*&user_id=not.is.null&limit=5000"),
    db.select("billing_memberships", "select=user_id&limit=20000"),
  ])
  const needle = q.trim().toLowerCase()
  const rows = users.map((u): AdminUserRow => {
    const p = profiles.find((x) => x.user_id === u.id)
    const st = statuses.find((x) => x.user_id === u.id)
    const sub = subs.find((x) => x.user_id === u.id)
    return {
      id: u.id, email: u.email, fullName: p?.full_name ?? "", accountType: p?.account_type ?? "", source: p?.source ?? "web", market: p?.market === "intl" ? "intl" : "ng",
      status: st?.status === "suspended" ? "suspended" : "active", createdAt: u.createdAt, lastSignInAt: u.lastSignInAt, confirmed: u.confirmed,
      plan: sub ? { plan: sub.plan, specialties: sub.specialties ?? [], status: sub.status, currentPeriodEnd: sub.current_period_end ?? null } : null,
      organisations: mems.filter((m) => m.user_id === u.id).length,
    }
  })
  const filtered = needle ? rows.filter((r) => r.email.toLowerCase().includes(needle) || r.fullName.toLowerCase().includes(needle)) : rows
  filtered.sort((a, b) => (b.createdAt ?? "").localeCompare(a.createdAt ?? ""))
  return { users: filtered, truncated }
}

export async function loadAdminUserDetail(userId: string) {
  const id = uuid(userId)
  const [auth, [profile], status, [sub], mems, orders, audit] = await Promise.all([
    getAuthUser(id), db.select("billing_profiles", `select=*&user_id=eq.${id}`), getUserStatus(id), db.select("billing_subscriptions", `select=*&user_id=eq.${id}`),
    db.select("billing_memberships", `select=org_id,role,joined_at&user_id=eq.${id}`),
    db.select("billing_orders", `select=reference,amount_kobo,currency,status,created_at,paid_at&payer_user_id=eq.${id}&order=created_at.desc&limit=20`),
    db.select("billing_audit_events", `select=*&actor_user_id=eq.${id}&order=at.desc&limit=30`),
  ])
  if (!auth) return null
  const orgIds = mems.map((m) => uuid(m.org_id))
  const orgs = orgIds.length ? await db.select("billing_organisations", `select=id,name&id=in.(${orgIds.join(",")})`) : []
  return {
    user: auth, profile: profile ?? null, status, subscription: sub ?? null,
    memberships: mems.map((m) => ({ orgId: m.org_id as string, role: m.role as string, joinedAt: m.joined_at as string, name: (orgs.find((o) => o.id === m.org_id)?.name ?? "") as string })),
    orders: orders.map((o) => ({ reference: o.reference as string, amountMinor: o.amount_kobo as number, currency: o.currency as string, status: o.status as string, createdAt: o.created_at as string, paidAt: (o.paid_at ?? null) as string | null })),
    audit,
  }
}

/** Deletes the sign-in account; profile, memberships, subscription and status rows follow by cascade. Paid orders are kept (their links are cleared). */
export async function deleteUserCompletely(userId: string): Promise<{ ok: true } | { ok: false; error: string }> {
  const id = uuid(userId)
  const owned = await db.select("billing_organisations", `select=id&owner_user_id=eq.${id}`)
  const verdict = canDeleteUser({ ownedOrganisations: owned.length })
  if (!verdict.ok) return verdict
  await db.remove("billing_orders", `payer_user_id=eq.${id}&status=eq.pending`) // an unpaid checkout must not outlive its owner
  await deleteAuthUser(id)
  return { ok: true }
}

export async function deleteOrganisationCompletely(orgId: string) {
  const id = uuid(orgId)
  await db.remove("billing_orders", `org_id=eq.${id}&status=eq.pending`)
  return (await db.remove("billing_organisations", `id=eq.${id}`)).length > 0
}

export async function getOrgOwner(orgId: string): Promise<{ name: string; ownerId: string } | null> {
  const [o] = await db.select("billing_organisations", `select=name,owner_user_id&id=eq.${uuid(orgId)}`)
  return o ? { name: o.name as string, ownerId: o.owner_user_id as string } : null
}

/** Administrator sets a person's plan directly (no payment): free, specialty premium, or all-access, for a number of months. */
export async function setUserPlan(userId: string, plan: "free" | "specialty" | "all_access", specialties: Specialty[], months: number): Promise<{ periodEnd: string | null }> {
  const id = uuid(userId)
  if (plan === "free") {
    const existing = await getSubscriptionFor({ userId: id })
    if (existing) await db.update("billing_subscriptions", `id=eq.${uuid(existing.id)}`, { status: "expired", current_period_end: new Date().toISOString(), cancel_at_period_end: false, updated_at: new Date().toISOString() })
    return { periodEnd: null }
  }
  const periodEnd = new Date(addMonthsUtc(Date.now(), months)).toISOString()
  const subId = await ensureSubscription({ userId: id }, { plan, specialties: plan === "specialty" ? specialties : [], seats: 1 })
  await db.update("billing_subscriptions", `id=eq.${uuid(subId)}`, {
    plan, specialties: plan === "specialty" ? specialties : [], seats: 1, status: "active", current_period_end: periodEnd, cancel_at_period_end: false, updated_at: new Date().toISOString(),
  })
  return { periodEnd }
}
