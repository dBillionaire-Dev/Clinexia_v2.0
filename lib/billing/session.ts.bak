// Account sign-in through Supabase Auth (GoTrue) over plain fetch, so no new library is needed. The anon key is used only
// on the server; the browser only ever holds two httpOnly cookies. Needs SUPABASE_URL and SUPABASE_ANON_KEY (new).
import { cookies, headers } from "next/headers"
import { getUserStatus } from "./store"

const ACCESS = "clinexia-access"
const REFRESH = "clinexia-refresh"

export interface AccountUser { id: string; email: string }
export interface Session { access_token: string; refresh_token: string; expires_in?: number }

function cfg() {
  const url = process.env.SUPABASE_URL
  const anon = process.env.SUPABASE_ANON_KEY
  if (!url || !anon) throw new Error("SUPABASE_URL and SUPABASE_ANON_KEY are required for accounts.")
  return { base: `${url.replace(/\/$/, "")}/auth/v1`, anon }
}

async function call(path: string, init: { method?: string; body?: unknown; token?: string }) {
  const { base, anon } = cfg()
  const res = await fetch(`${base}/${path}`, {
    method: init.method ?? "POST",
    headers: { apikey: anon, "Content-Type": "application/json", ...(init.token ? { Authorization: `Bearer ${init.token}` } : {}) },
    body: init.body === undefined ? undefined : JSON.stringify(init.body),
    cache: "no-store",
  })
  const json = (await res.json().catch(() => null)) as any
  return { ok: res.ok, status: res.status, json }
}

export async function signUpUser(email: string, password: string, fullName: string, redirectTo?: string): Promise<{ userId: string | null; session: Session | null }> {
  const r = await call(redirectTo ? `signup?redirect_to=${encodeURIComponent(redirectTo)}` : "signup", { body: { email, password, data: { full_name: fullName } } })
  if (!r.ok) throw new Error(`signup ${r.status}`)
  const user = r.json?.user ?? r.json
  const session = r.json?.access_token ? r.json : r.json?.session ?? null
  return { userId: typeof user?.id === "string" ? user.id : null, session }
}

export type SignInResult = { session: Session } | { error: "unconfirmed" | "invalid" }

export async function signInUser(email: string, password: string): Promise<SignInResult> {
  const r = await call("token?grant_type=password", { body: { email, password } })
  if (r.ok && r.json?.access_token) return { session: r.json as Session }
  const code = String(r.json?.error_code ?? r.json?.code ?? "")
  const msg = String(r.json?.msg ?? r.json?.message ?? r.json?.error_description ?? "").toLowerCase()
  return { error: code === "email_not_confirmed" || msg.includes("not confirmed") ? "unconfirmed" : "invalid" }
}

/** Sends the confirmation email again. Callers must answer the same way whether or not the address exists. */
export async function resendConfirmation(email: string, redirectTo?: string): Promise<void> {
  await call(redirectTo ? `resend?redirect_to=${encodeURIComponent(redirectTo)}` : "resend", { body: { type: "signup", email } })
}

export type ResetFailure = "invalid" | "same" | "weak" | "error"

/**
 * Finishes a password reset: trades the one-time token for a short session, sets the new password with it, then signs that session
 * and every other session of the account out (a reset usually means someone else may have had access).
 */
export async function completePasswordReset(tokenHash: string, password: string): Promise<{ ok: true; email: string } | { ok: false; reason: ResetFailure }> {
  const v = await call("verify", { body: { type: "recovery", token_hash: tokenHash } })
  if (!v.ok || typeof v.json?.access_token !== "string") return { ok: false, reason: v.status >= 500 ? "error" : "invalid" }
  const token = v.json.access_token as string
  const email = typeof v.json?.user?.email === "string" ? (v.json.user.email as string) : ""
  const put = await call("user", { method: "PUT", token, body: { password } })
  if (!put.ok) {
    const code = String(put.json?.error_code ?? put.json?.code ?? "")
    await call("logout", { token, body: {} }).catch(() => undefined)
    return { ok: false, reason: code === "same_password" ? "same" : code === "weak_password" ? "weak" : "error" }
  }
  await call("logout?scope=global", { token, body: {} }).catch(() => undefined)
  return { ok: true, email }
}

export async function refreshSession(refreshToken: string): Promise<Session | null> {
  const r = await call("token?grant_type=refresh_token", { body: { refresh_token: refreshToken } })
  return r.ok && r.json?.access_token ? (r.json as Session) : null
}

export async function userFromAccessToken(token: string): Promise<AccountUser | null> {
  const r = await call("user", { method: "GET", token })
  return r.ok && typeof r.json?.id === "string" && typeof r.json?.email === "string" ? { id: r.json.id, email: r.json.email } : null
}

const secure = () => process.env.NODE_ENV === "production"

export async function setSessionCookies(session: Session) {
  const store = await cookies()
  store.set(ACCESS, session.access_token, { httpOnly: true, secure: secure(), sameSite: "lax", path: "/", maxAge: Math.max(60, session.expires_in ?? 3600) })
  store.set(REFRESH, session.refresh_token, { httpOnly: true, secure: secure(), sameSite: "lax", path: "/", maxAge: 60 * 60 * 24 * 30 })
}

export async function clearSessionCookies() {
  const store = await cookies()
  store.delete(ACCESS)
  store.delete(REFRESH)
}

/** Suspended accounts are treated as signed out everywhere. If the status cannot be read, access is denied (fail closed). */
async function allowed(user: AccountUser | null): Promise<AccountUser | null> {
  if (!user) return null
  try {
    return (await getUserStatus(user.id)).status === "suspended" ? null : user
  } catch {
    return null
  }
}

/** The signed-in user, verified with Supabase on every call (the token is never trusted on its own). Call from route handlers. */
export async function currentUser(): Promise<AccountUser | null> {
  // The mobile apps send "Authorization: Bearer <token>". When that header is present it is the only thing consulted.
  const auth = (await headers()).get("authorization")
  if (auth) {
    const m = /^Bearer\s+(\S+)$/i.exec(auth.trim())
    return m ? allowed(await userFromAccessToken(m[1])) : null
  }
  const store = await cookies()
  const access = store.get(ACCESS)?.value
  if (access) {
    const user = await userFromAccessToken(access)
    if (user) return allowed(user)
  }
  const refresh = store.get(REFRESH)?.value
  if (!refresh) return null
  const session = await refreshSession(refresh)
  if (!session) return null
  const user = await allowed(await userFromAccessToken(session.access_token))
  if (!user) return null
  await setSessionCookies(session).catch(() => undefined)
  return user
}

/** Ends the sign-in session behind a token (best effort; the app also forgets its copy). */
export async function revokeToken(accessToken: string): Promise<void> {
  await call("logout", { token: accessToken, body: {} }).catch(() => undefined)
}
