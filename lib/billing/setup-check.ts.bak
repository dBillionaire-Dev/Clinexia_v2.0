// "Is production set up?" Tries each table, column, function and setting the account, campaign and notification features need, and says
// exactly which SQL file or setting is missing. Never returns a secret's value, only whether it is present.
import { db } from "./db"
import { missingSqlHint, errorText } from "./setup-hints"
import { parseServiceAccount } from "../push/fcm"

export interface Check { label: string; group: string; ok: boolean; optional: boolean; fix?: string; detail?: string }

const TABLES: Array<[string, string, string, string]> = [
  // [group, label, request, fix]
  ["Accounts and plans", "Profiles, organisations, memberships, invitations", "billing_organisations?select=id&limit=1", "supabase/billing.sql"],
  ["Accounts and plans", "Subscriptions, orders, price settings", "billing_settings?select=id&limit=1", "supabase/billing.sql"],
  ["Accounts and plans", "Profile: pricing market and where the account was created", "billing_profiles?select=market,source&limit=1", "supabase/billing-admin.sql"],
  ["Accounts and plans", "Suspension (user status)", "billing_user_status?select=user_id&limit=1", "supabase/billing-admin.sql"],
  ["Device linking", "Device links (real name and history in the admin)", "billing_device_links?select=anonymous_id&limit=1", "supabase/billing-link.sql"],
  ["Campaigns", "Campaigns", "app_campaigns?select=id,platforms&limit=1", "supabase/campaigns.sql"],
  ["Campaigns", "Answers linked to accounts", "app_campaign_responses?select=id,user_id&limit=1", "supabase/campaigns.sql"],
  ["Campaigns", "Reminders that follow the account", "app_campaign_parked?select=user_id&limit=1", "supabase/campaigns.sql"],
  ["Billing switch", "Switch-on button and free trial", "billing_launch?select=enforce&limit=1", "supabase/billing-launch.sql"],
  ["Emails", "Invitation email tracking", "billing_invitations?select=emailed_at&limit=1", "supabase/email-notifications.sql"],
  ["Emails", "Receipt email tracking", "billing_orders?select=receipt_sent_at&limit=1", "supabase/email-notifications.sql"],
  ["Emails", "Plan-ending reminder tracking", "billing_subscriptions?select=reminder_sent_for&limit=1", "supabase/email-notifications.sql"],
  ["Phone notifications", "Registered phones and sent messages", "push_devices?select=token&limit=1", "supabase/push.sql"],
  ["Phone notifications", "Sent messages", "push_messages?select=id&limit=1", "supabase/push.sql"],
  ["Analytics (already in place)", "Devices and calculation events", "convertlab_devices?select=anonymous_id&limit=1", "supabase/analytics.sql"],
  ["Analytics (already in place)", "Calculation history", "calculation_events?select=calculator_id&limit=1", "supabase/analytics.sql"],
]

const ZERO = "00000000-0000-0000-0000-000000000000"
const FUNCTIONS: Array<[string, string, string, Record<string, unknown>, string]> = [
  ["Device linking", "Link devices to accounts (function)", "billing_link_device", { p_anonymous_id: ZERO, p_user: ZERO, p_name: "" }, "supabase/billing-link.sql"],
  ["Accounts and plans", "Apply a paid order (function)", "billing_apply_paid_order", { p_reference: "setup-check", p_amount: 0, p_currency: "NGN", p_provider_id: "x" }, "supabase/billing.sql"],
]

async function attempt(run: () => Promise<unknown>, fix: string): Promise<{ ok: boolean; detail?: string }> {
  try { await run(); return { ok: true } } catch (e) {
    const message = errorText(e)
    // A function that exists but rejects our dummy values (e.g. a foreign-key error) is present.
    if (!missingSqlHint(message) && /23503|foreign key|unknown_reference/i.test(message)) return { ok: true }
    return { ok: false, detail: missingSqlHint(message) ?? message.slice(0, 160) }
  }
}

export async function runSetupCheck(env: Record<string, string | undefined> = process.env): Promise<Check[]> {
  const out: Check[] = []
  const has = (k: string) => Boolean(env[k] && env[k]!.trim())
  const setting = (label: string, ok: boolean, optional: boolean, fix: string) => out.push({ group: "Server settings (Vercel environment variables)", label, ok, optional, fix: ok ? undefined : fix })

  setting("SUPABASE_URL", has("SUPABASE_URL"), false, "Add SUPABASE_URL")
  setting("SUPABASE_SERVICE_ROLE_KEY", has("SUPABASE_SERVICE_ROLE_KEY"), false, "Add SUPABASE_SERVICE_ROLE_KEY (the service role key, not the anon key)")
  setting("SUPABASE_ANON_KEY (sign-in)", has("SUPABASE_ANON_KEY"), false, "Add SUPABASE_ANON_KEY (Supabase > Project Settings > API > anon public key)")
  setting("PAYSTACK_SECRET_KEY (payments)", has("PAYSTACK_SECRET_KEY"), true, "Add PAYSTACK_SECRET_KEY to take payments")
  setting("FCM_SERVICE_ACCOUNT_JSON (phone notifications)", parseServiceAccount(env.FCM_SERVICE_ACCOUNT_JSON) !== null, true, "Add FCM_SERVICE_ACCOUNT_JSON (Firebase service account key) to send notifications")
  setting("RESEND_API_KEY + BILLING_FROM_EMAIL (emailed notices)", has("RESEND_API_KEY") && has("BILLING_FROM_EMAIL"), true, "Add both to email invitations, receipts, plan reminders and account notices (the sending domain must be verified in Resend)")
  setting("CRON_SECRET (daily plan-ending reminders)", has("CRON_SECRET"), true, "Add CRON_SECRET (any long random string) in Vercel; vercel.json then runs the reminder job daily")
  setting("Accounts switched on (BILLING_ENABLED is not 'false')", env.BILLING_ENABLED !== "false", false, "Remove BILLING_ENABLED=false")

  if (!has("SUPABASE_URL") || !has("SUPABASE_SERVICE_ROLE_KEY")) return out
  const results = await Promise.all([
    ...TABLES.map(async ([group, label, request, fix]) => ({ group, label, fix, ...(await attempt(() => db.select(request.split("?")[0], request.split("?")[1]), fix)) })),
    ...FUNCTIONS.map(async ([group, label, fn, args, fix]) => ({ group, label, fix, ...(await attempt(() => db.rpc(fn, args), fix)) })),
  ])
  for (const r of results) out.push({ group: r.group, label: r.label, ok: r.ok, optional: false, fix: r.ok ? undefined : r.fix, detail: r.detail })
  return out
}

export function summariseChecks(checks: Check[]) {
  const failed = checks.filter((c) => !c.ok && !c.optional)
  const optionalMissing = checks.filter((c) => !c.ok && c.optional)
  const files = [...new Set(failed.map((c) => c.fix).filter((f): f is string => Boolean(f && f.startsWith("supabase/"))))]
  return { failed: failed.length, optionalMissing: optionalMissing.length, files, ready: failed.length === 0 }
}
