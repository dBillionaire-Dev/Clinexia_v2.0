import { describe, expect, it } from "vitest"
import { cleanTrialDays, resolveLaunch, trialEnd } from "./launch"

const NOW = Date.parse("2026-11-01T00:00:00Z")
const DAY = 86_400_000
const off = { enforce: false, freeUntil: null }

describe("billing switch and free trial", () => {
  it("is off by default: nothing locked", () => {
    expect(resolveLaunch(off, {}, NOW)).toMatchObject({ enforced: false, trial: false, switchedOn: false })
  })
  it("admin switch on, no trial: locked immediately", () => {
    expect(resolveLaunch({ enforce: true, freeUntil: null }, {}, NOW)).toMatchObject({ enforced: true, trial: false, switchedOn: true, adminOn: true })
  })
  it("during the free trial nothing is locked, and the date is reported", () => {
    const s = { enforce: true, freeUntil: new Date(NOW + 10 * DAY).toISOString() }
    expect(resolveLaunch(s, {}, NOW)).toMatchObject({ enforced: false, trial: true, freeUntil: s.freeUntil })
  })
  it("locks start the moment the trial ends", () => {
    const end = NOW + 10 * DAY
    const s = { enforce: true, freeUntil: new Date(end).toISOString() }
    expect(resolveLaunch(s, {}, end - 1).enforced).toBe(false)
    expect(resolveLaunch(s, {}, end).enforced).toBe(true)
    expect(resolveLaunch(s, {}, end + DAY)).toMatchObject({ enforced: true, trial: false })
  })
  it("a trial date does nothing while billing is switched off", () => {
    expect(resolveLaunch({ enforce: false, freeUntil: new Date(NOW + DAY).toISOString() }, {}, NOW)).toMatchObject({ enforced: false, trial: false, freeUntil: null })
  })
  it("the old environment setting still locks, and the trial applies to it too", () => {
    expect(resolveLaunch(off, { BILLING_ENFORCE_PREMIUM: "true" }, NOW)).toMatchObject({ enforced: true, envForced: true })
    expect(resolveLaunch({ enforce: false, freeUntil: new Date(NOW + DAY).toISOString() }, { BILLING_ENFORCE_PREMIUM: "true" }, NOW)).toMatchObject({ enforced: false, trial: true })
  })
  it("BILLING_ENABLED=false beats everything", () => {
    expect(resolveLaunch({ enforce: true, freeUntil: null }, { BILLING_ENABLED: "false", BILLING_ENFORCE_PREMIUM: "true" }, NOW)).toMatchObject({ enforced: false, switchedOn: false })
  })
  it("trial helpers", () => {
    expect(trialEnd(NOW, 30)).toBe(new Date(NOW + 30 * DAY).toISOString())
    expect(trialEnd(NOW, 0)).toBeNull()
    expect([cleanTrialDays(30), cleanTrialDays("0"), cleanTrialDays(-1), cleanTrialDays(366), cleanTrialDays(1.5), cleanTrialDays("x")]).toEqual([30, 0, null, null, null, null])
  })
})
